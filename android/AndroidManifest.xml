<?xml version="1.0" encoding="utf-8"?>
<!-- TruckBuild as an Android app: the game's web page, shown in a WebView
     that takes up the whole screen. The page and everything it needs is
     packed inside the app, so there is no INTERNET permission here: the app
     cannot go online at all. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.tpappart.truckbuild">

    <application
        android:allowBackup="true"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Game">

        <!-- configChanges: the page rearranges itself when the screen turns
             or changes size. Without this Android would restart the app,
             and a race with it. -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density|keyboard|keyboardHidden|navigation|uiMode"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="fullUser">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
